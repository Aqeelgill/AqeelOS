# AqeelOS Environment Configuration (example)
# Copy this file to .env and fill in your values locally. Never commit .env.

# App secret (change on first owner login)
AQEELOS_SECRET=aqeelos-local-dev-secret-change-on-first-owner-login

# Database path
AQEELOS_DB=/home/aqeel-gill/ai-team/my-ai-team/aqeelos/aqeelos.db

# LLM Provider: ollama (local) or groq (online)
LLM_PROVIDER=groq

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Groq API (online deployment)
GROQ_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Telegram Bot Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Worker poll interval (seconds)
AQEELOS_WORKER_POLL=2.0

# LLM request timeout (seconds)
LLM_TIMEOUT=120
